# =============================================================================
# SENTINEL AI FRAUD DETECTION SYSTEM - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual Supabase credentials.
# NEVER commit .env with production passwords or service keys into source control.

# Supabase PostgreSQL Direct JDBC Connection
SUPABASE_DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD

# Supabase API Configuration (for Backend & Frontend)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Application Server Configuration
PORT=8080
ENVIRONMENT=development
